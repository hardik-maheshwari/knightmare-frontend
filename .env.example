# Public URL of the deployed backend (no trailing slash). Baked in at BUILD time,
# so pass it to `npm run build` (e.g. VITE_BACKEND_URL=... npm run build) before deploying.
# Leave unset for local dev: Vite proxies /api (and WebSockets) to localhost:8080.
VITE_BACKEND_URL=https://your-backend.example.com
